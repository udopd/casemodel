{
  "name": "casemodel",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first web CASE workbench for IDEF0, DFD, and IDEF3 process modeling.",
  "engines": {
    "node": ">=24.14.1 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/normalize-export-segments.mjs",
